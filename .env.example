# Copy to ~/.config/garage-goldstar/.env and chmod 600.
# Real environment variables always override this file.

# ── Gemini ────────────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Run `goldstar models` to list what your key can call.
GEMINI_MODEL=gemini-3.1-flash-lite

# ── Hostinger mailbox ─────────────────────────────────────────────────────
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=invoices@yourdomain.co.uk
IMAP_PASS=
IMAP_MAILBOX=INBOX

# How many days back each run scans. Already-processed messages are skipped
# by UID and by file hash, so a generous window costs nothing.
LOOKBACK_DAYS=7

# ── Local storage ─────────────────────────────────────────────────────────
# Database, archived PDFs and Excel exports all live under DATA_DIR.
# DATA_DIR=/home/youruser/.local/share/garage-goldstar

# Dashboard bind address. Leave this on 127.0.0.1 even when publishing through
# a Cloudflare tunnel — cloudflared connects over loopback, so the listener
# never needs to face the network. See deploy/TUNNEL.md.
WEB_ADDR=127.0.0.1:8787

# ── Dashboard security ────────────────────────────────────────────────────
# Dashboard accounts live in the database now, not here — create the first
# one with:
#   goldstar user-add <username> <password> admin
# GOLDSTAR_USER/GOLDSTAR_EMAIL/GOLDSTAR_PASSWORD_HASH below are only read
# once, on an install's very first run, to migrate a pre-multi-user config
# into an equivalent admin account. Safe to remove afterward.
GOLDSTAR_USER=your-username
GOLDSTAR_EMAIL=you@example.com

# Automatic mailbox sync while the dashboard is running. The zone is an IANA
# name, so a clock time stays put across the BST/GMT change. Blank/unset all
# three of SYNC_MINUTE, SYNC_EVERY and SYNC_AT to disable.
#
# Three ways to schedule it, most specific wins:
#   GOLDSTAR_SYNC_MINUTE  hourly at this minute past the hour (0-59) — the
#                         same real clock time every hour no matter how many
#                         times the process has restarted since. Preferred:
#                         GOLDSTAR_SYNC_EVERY's countdown restarts with the
#                         process, so it silently drifts across redeploys.
#   GOLDSTAR_SYNC_EVERY   a plain interval ("1h", "30m") counted from
#                         whenever this process last started.
#   GOLDSTAR_SYNC_AT      once a day at a fixed clock time ("18:30").
GOLDSTAR_SYNC_MINUTE=30
# GOLDSTAR_SYNC_EVERY=1h
# GOLDSTAR_SYNC_AT=18:30
GOLDSTAR_SYNC_TZ=Europe/London

GOLDSTAR_PASSWORD_HASH=

# Two-factor auth (TOTP — Authy, Google Authenticator, 1Password, ...) is
# mandatory whenever a password is set above: there is nothing to configure
# here. The first login after this is deployed shows a QR code and requires
# scanning it before the dashboard is reachable; every login after that asks
# for a 6-digit code. The secret lives in <data dir>/totp.secret, generated
# on first setup — never set by hand. Lost the device? Run
# `goldstar totp-reset` on the server and restart; the next login sets it
# up again from a fresh QR code.

# Set true when serving through a Cloudflare tunnel (Cloudflare terminates
# TLS, so session cookies must be marked Secure).
GOLDSTAR_COOKIE_SECURE=false

# Explicit opt-out for a private machine with no tunnel. Leave false: a
# tunnel reaches the app over loopback, so a 127.0.0.1 bind proves nothing.
GOLDSTAR_ALLOW_NO_PASSWORD=false
