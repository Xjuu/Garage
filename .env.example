# Copy to ~/.config/garage-goldstar/.env and chmod 600.
# Real environment variables always override this file.

# ── Gemini ────────────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Run `goldstar models` to list what your key can call.
GEMINI_MODEL=gemini-3.1-flash-lite

# ── Hostinger mailbox ─────────────────────────────────────────────────────
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=invoices@yourdomain.co.uk
IMAP_PASS=
IMAP_MAILBOX=INBOX

# How many days back each run scans. Already-processed messages are skipped
# by UID and by file hash, so a generous window costs nothing.
LOOKBACK_DAYS=7

# ── Local storage ─────────────────────────────────────────────────────────
# Database, archived PDFs and Excel exports all live under DATA_DIR.
# DATA_DIR=/home/youruser/.local/share/garage-goldstar

# Dashboard bind address. Leave this on 127.0.0.1 even when publishing through
# a Cloudflare tunnel — cloudflared connects over loopback, so the listener
# never needs to face the network. See deploy/TUNNEL.md.
WEB_ADDR=127.0.0.1:8787

# ── Dashboard security ────────────────────────────────────────────────────
# REQUIRED unless GOLDSTAR_ALLOW_NO_PASSWORD=true. Generate with:
#   goldstar passwd
# Sign-in identity. Either the username or the email works with the password.
GOLDSTAR_USER=your-username
GOLDSTAR_EMAIL=you@example.com

# Daily automatic mailbox sync while the dashboard is running. The zone is an
# IANA name, so 18:30 stays 18:30 across the BST/GMT change. Blank to disable.
GOLDSTAR_SYNC_AT=18:30
GOLDSTAR_SYNC_TZ=Europe/London

GOLDSTAR_PASSWORD_HASH=

# Set true when serving through a Cloudflare tunnel (Cloudflare terminates
# TLS, so session cookies must be marked Secure).
GOLDSTAR_COOKIE_SECURE=false

# Explicit opt-out for a private machine with no tunnel. Leave false: a
# tunnel reaches the app over loopback, so a 127.0.0.1 bind proves nothing.
GOLDSTAR_ALLOW_NO_PASSWORD=false
