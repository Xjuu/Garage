[Unit]
Description=Garage Goldstar local invoice dashboard
After=network.target

[Service]
Type=simple
ExecStart=__BINDIR__/goldstar serve
# Settings and data live beside the binary; see WorkingDirectory below.
WorkingDirectory=__BINDIR__
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__BINDIR__
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true

# Outbound access is required: the app connects to the IMAP server and to the
# Gemini API. Denying it here would leave the dashboard running but unable to
# collect anything, with a connection error and no hint as to the cause.
#
# What keeps the dashboard private is WEB_ADDR binding to 127.0.0.1, with a
# tunnel or reverse proxy in front — not a socket filter.

[Install]
WantedBy=default.target
